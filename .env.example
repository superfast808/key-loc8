# Host port exposed only on loopback for the Plesk reverse proxy.
APP_PORT=8088

# PostgreSQL 16 container.
POSTGRES_DB=keyloc8
POSTGRES_USER=keyloc8
# Use a long URL-safe password (letters/numbers/_/-) because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SESSION_SECRET
# Keep true when Plesk serves the site over HTTPS. Set false only for direct HTTP testing.
SESSION_COOKIE_SECURE=true

# Public URL used for links such as password resets.
APP_BASE_URL=https://staff.shopkillieicehockey.com

# Email (Brevo preferred; SendGrid fallback)
FROM_EMAIL=
BREVO_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Twilio / SMS 2FA
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_FROM_NUMBER=

# Deputy integration
DEPUTY_API_TOKEN=
